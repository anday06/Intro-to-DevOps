{
  "name": "devops-todo-api",
  "version": "1.0.0",
  "private": true,
  "description": "A containerized Todo REST API for a DevOps assignment",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
